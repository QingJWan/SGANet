import torch
import torch.nn as nn
class WeightedFeatureFusion(nn.Module):
    def __init__(self, input_dim_x, input_dim_pooled):
        super(WeightedFeatureFusion, self).__init__()

        self.weight_x = nn.Parameter(torch.ones(input_dim_x))  
        self.weight_pooled = nn.Parameter(torch.ones(input_dim_pooled))  

    def forward(self, x, pooled):

        # weighted_x = x * self.weight_x
        # weighted_pooled = pooled * self.weight_pooled
        weighted_x = x * self.weight_x.view(1, -1, 1, 1)  
        weighted_pooled = pooled * self.weight_pooled.view(1, -1, 1, 1)  


        fused_features = weighted_x + weighted_pooled
        return fused_features
